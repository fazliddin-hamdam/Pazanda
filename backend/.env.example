# Lokal ishlab chiqish: SQLite. Prod: postgresql+psycopg://user:pass@host:5432/ovqatbot
DATABASE_URL=sqlite:///./ovqatbot.db

# @BotFather dan olingan token va Mini App manzili (https bo'lishi shart)
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=

# true — brauzerda Telegramsiz sinash uchun ("Mehmon" foydalanuvchi). Prod'da false!
DEV_MODE=true

# Gemini API kaliti: https://aistudio.google.com/apikey (bepul tarif).
# Bo'sh qoldirilsa qoidaga asoslangan parser va tayyor retseptlar ishlaydi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# n8n workflow /api/admin/recipes ga retsept yozishi uchun (X-Admin-Token sarlavhasi)
ADMIN_TOKEN=

CORS_ORIGINS=*
